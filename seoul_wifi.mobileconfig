<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>AutoJoin</key>
            <true/>
            <key>EncryptionType</key>
            <string>WPA2</string>
            <key>HIDDEN_NETWORK</key>
            <false/>
            <key>SSID_STR</key>
            <string>SEOUL_Secure</string>
            <key>EAPClientConfiguration</key>
            <dict>
                <key>AcceptEAPTypes</key>
                <array>
                    <integer>25</integer> <!-- 25는 PEAP 방식을 의미 -->
                </array>
                <key>UserName</key>
                <string>seoul</string>
                <key>UserPassword</key>
                <string>seoul</string>
            </dict>
            <key>PayloadType</key>
            <string>com.apple.wifi.managed</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>PayloadIdentifier</key>
            <string>com.seoul.wifi.profile</string>
            <key>PayloadUUID</key>
            <string>A1B2C3D4-E5F6-7890-ABCD-EF1234567890</string>
        </dict>
    </array>
    <key>PayloadDisplayName</key>
    <string>서울시 공공와이파이(SEOUL_Secure)</string>
    <key>PayloadIdentifier</key>
    <string>com.seoul.wifi</string>
    <key>PayloadRemovalDisallowed</key>
    <false/>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>12345678-ABCD-EF12-3456-7890ABCDEF12</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>